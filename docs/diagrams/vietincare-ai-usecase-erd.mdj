        {
          "_type": "UMLUseCase",
          "_id": "q848wsQVRC2Y/TPJkSValA==",
          "_parent": {
            "$ref": "xIW5pY7JQRqfSBcsAmuUYg=="
          },
          "name": "UC003.1 — Theo dõi tiến độ Ticket",
          "documentation": "Nguồn: docs/customer-requirement.md, quyền Khách hàng. ID chi tiết để truy vết nhóm nghiệp vụ Ticket, không hàm ý include với Tạo Ticket. Điều kiện trước: Ticket đã tồn tại và thuộc khách hàng."
