HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=QLKHViettin
DB_USER=vietincare_app
# Set DB_PASSWORD locally in the process environment. Never commit real credentials.
DB_PASSWORD=
SESSION_HOURS=8
COOKIE_SECURE=false

# Use scripts/start-local.ps1 -EnableAI for a hidden key prompt.
# Never commit a real OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Gemini: hidden prompt with start-local.ps1 -EnableAI -AIProvider gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
